# Path to a Google Cloud service account key JSON file with Speech-to-Text access.
# Never commit the actual key file.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# When "true", use an in-process synthetic STT stream instead of calling Google Cloud
# Speech-to-Text. Lets you run/test the app locally without GOOGLE_APPLICATION_CREDENTIALS.
# Dev-only — never set true in production.
MOCK_STT=false

# HTTP/WebSocket port.
PORT=8080

# Comma-separated list of allowed frontend origins for CORS + WS upgrade checks.
# Leave empty in local development to allow any origin.
ALLOWED_ORIGINS=

# Caps to bound memory usage and Google STT billing/quota exposure.
MAX_ACTIVE_ROOMS=5
MAX_LISTENERS_PER_ROOM=500
