# Path to a Google Cloud service account key JSON file with Speech-to-Text access.
# Never commit the actual key file.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# HTTP/WebSocket port.
PORT=8080

# Comma-separated list of allowed frontend origins for CORS + WS upgrade checks.
# Leave empty in local development to allow any origin.
ALLOWED_ORIGINS=

# Caps to bound memory usage and Google STT billing/quota exposure.
MAX_ACTIVE_ROOMS=5
MAX_LISTENERS_PER_ROOM=500
